# CRICKETVERSE AI - Environment Configuration Example
PROJECT_NAME="CRICKETVERSE AI"
API_V1_STR="/api/v1"
SECRET_KEY="cricketverse_super_secret_jwt_key_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL="sqlite:///./cricketverse.db"

# Storage
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=100

# External APIs (Optional - App uses authentic demo fallback when missing)
CRICAPI_KEY=""
WEATHER_API_KEY=""

# Allowed CORS Origins
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
